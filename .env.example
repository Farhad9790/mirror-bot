# Telegram
TELEGRAM_BOT_TOKEN=123456789:replace-me
# Comma-separated Telegram user IDs. Empty = anyone can use the bot.
ALLOWED_USER_IDS=

# Upload destination
# Optional. Uses your Gofile account for uploads and share-link downloads.
# Without it Gofile uses guest uploads (public folder per upload) and guest tokens.
GOFILE_TOKEN=
# Gofile share links are read with a temporary guest token. Only change this if
# Gofile rotates the website-token salt in https://gofile.io/js/wt.obf.js.
# GOFILE_WT_SALT=12af056dacea0b

# Limits
MAX_FILE_SIZE=8G
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT=7200
# 0 = run forever (local). GitHub Actions sets ~4h45m per run.
BOT_RUN_SECONDS=0
MULTI_FILE_MODE=largest

# Video downloads
YTDLP_FORMAT=bv*+ba/b
# Optional Netscape-format cookies file for age/region locked sites.
COOKIES_FILE=

# Paths
DOWNLOAD_DIR=downloads
STATE_FILE=.state/telegram.json
ARIA2C_PATH=aria2c

# Debug
LOG_LEVEL=INFO
# Only enable for local testing. Never expose this bot publicly with private URLs allowed.
ALLOW_PRIVATE_URLS=0
